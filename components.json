{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "src/styles/globals.css",
    "baseColor": "slate",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/components",
    "ui": "@/components/ui",
    "utils": "@/lib/utils",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "resolvedPaths": {
    "components": "./src/components",
    "ui": "./src/components/ui",
    "utils": "./src/lib/utils",
    "lib": "./src/lib",
    "hooks": "./src/hooks"
  },
  "iconLibrary": "lucide"
}
